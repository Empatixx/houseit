{
  "name": "@houseit/mcp",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "turbo": {
    "tags": [
      "app"
    ]
  },
  "bin": {
    "houseit": "./dist/cli.js"
  },
  "scripts": {
    "build": "bun build src/server.ts src/cli.ts --target=node --outdir dist --external playwright-core",
    "start": "node dist/server.js",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@houseit/bridge": "workspace:*",
    "@houseit/commands": "workspace:*",
    "@houseit/core": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "playwright-core": "^1.62.1",
    "zod": "^4.5.2"
  },
  "devDependencies": {
    "@houseit/typescript-config": "workspace:*",
    "@houseit/vitest-config": "workspace:*",
    "@types/node": "^24.0.0",
    "vitest": "^4.1.11"
  }
}
